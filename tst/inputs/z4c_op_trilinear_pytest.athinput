# GR-Boris low-order geodesic fallback regression (experiment/ST-trilinear-fallback).
#
# One moving-puncture BH on a deliberately coarse uniform grid plus a well-resolved outer
# ring. The inner ring is meant to be the regime the fallback exists for; the outer ring
# is the control that must be unaffected. Excision is OFF so nothing is removed before it
# can be pushed, and feedback is OFF so the only thing under test is the pusher.
#
# MEASURED, and worth knowing: this fixture does NOT produce a rejection. Three
# configurations were tried on 4 x MI210 (session 04a) -- r = 0.3 at dx = 1/3 for 24
# cycles, r = 0.12 at dx = 1/3 for 40 cycles, and r = 0.12 at dx = 2/3 for 40 cycles --
# and all three gave zero rejected substeps, so the fallback never fires and all three
# modes agree bitwise. A 2*NGHOST-node interpolant copes with a STATIONARY trumpet at
# every resolution tried; the failure the fallback repairs needs the dynamical,
# under-resolved collapse, where chi falls faster than the grid can follow. This deck
# therefore pins the "changes nothing when nothing is rejected" half of the contract, and
# the test asserts exactly that in this branch; the rescue itself is covered by the
# y_c = 0.700 acceptance run.
#
# <particles> trilinear_fallback is listed here because the athinput command line can
# override an existing key but cannot add one (parameter_input.cpp ModifyFromCmdline).

<comment>
problem = trilinear geodesic fallback at an under-resolved puncture

<job>
basename = op_trilinear

<mesh>
nghost = 4
nx1 = 48
x1min = -8.0
x1max = 8.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 48
x2min = -8.0
x2max = 8.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 48
x3min = -8.0
x3max = 8.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<z4c>
lapse_harmonic = 0.0
lapse_oplog = 2.0
shift_eta = 2.0
diss = 0.1
chi_div_floor = 0.00001
damp_kappa1 = 0.02
damp_kappa2 = 0.0
co_0_x = 0.0
co_0_type = BH

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = 24
tlim = 50.0
ndiag = 1

<particles>
particle_type = dust
pusher = gr_boris
init = pgen
feedback = false
mass = 1.0e-3
debug = 0
destroy_log = false
excise_radius = 0.0
excise_lapse = 0.0
trilinear_fallback = none

<problem>
punc_ADM_mass = 1.0
prtcl_np = 32
prtcl_r1 = 0.3
prtcl_r2 = 5.0

<output1>
file_type = pvtk
variable = prtcl_all
dt = 0.4
