# Oppenheimer-Snyder dust-collapse acceptance case with live chi-AMR and feedback.

<comment>
problem = OS collapse with particle feedback through dynamic AMR

<job>
basename = os_amr_t

<mesh>
nghost = 4
nx1 = 48
x1min = -10.5
x1max = 10.5
ix1_bc = outflow
ox1_bc = outflow
nx2 = 48
x2min = -10.5
x2max = 10.5
ix2_bc = outflow
ox2_bc = outflow
nx3 = 48
x3min = -10.5
x3max = 10.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement = adaptive
max_nmb_per_rank = 512
num_levels = 3
refinement_interval = 2

<amr_criterion0>
method = user

<z4c_amr>
method = chi
chi_min = 0.60

<z4c>
lapse_harmonic = 0.0
lapse_oplog = 2.0
shift_eta = 2.0
diss = 0.1
chi_div_floor = 0.00001
damp_kappa1 = 0.02
damp_kappa2 = 0.0

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = 5
tlim = 40.0
ndiag = 1

<particles>
particle_type = dust
pusher = gr_boris
init = pgen
feedback = true
mass = 1.0
debug = 1
destroy_log = true
excise_radius = 0.0
excise_lapse = 0.1
cross_level_deposit = conservative

<problem>
os_mass = 1.0
os_radius_over_mass = 5.0
os_lattice_n = 16
os_precollapsed_lapse = false

<output1>
file_type = pvtk
variable = prtcl_all
dt = 0.25

<output2>
file_type = bin
variable = tmunu
dt = 0.25

<output3>
file_type = rst
dt = 50.0
