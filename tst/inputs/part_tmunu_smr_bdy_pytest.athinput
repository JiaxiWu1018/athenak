# Conservative coarse-to-fine deposition beside a closed transverse boundary. The cloud
# is represented on the fine sublevel, so its physical-boundary clip must use that same
# fine stencil for the exact particle-to-cell identity to close.

<comment>
problem = conservative Tmunu seam and closed-boundary regression

<job>
basename = part_tmunu_smr_bdy

<mesh>
nghost = 2
nx1 = 32
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 32
x2min = -1.0
x2max = 1.0
ix2_bc = outflow
ox2_bc = outflow

nx3 = 32
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement = static

<refined_region1>
level = 1
x1min = 0.1
x1max = 0.9
x2min = -0.95
x2max = 0.95
x3min = -0.95
x3max = 0.95

<coord>
general_rel = true
minkowski = true
excise = false

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.25
nlim = 0
tlim = 1.0
ndiag = 1

<z4c>
diss = 0.0

<particles>
particle_type = dust
pusher = drift
init = pgen
mass = 1.0
feedback = true
debug = 1
destroy_log = false
cross_level_deposit = conservative

<problem>
mode = single
px = -0.0078125
py = -0.984375
pz = -0.25
pux = 0.0
puy = 0.0
puz = 0.0
pmass = 1.0

<output1>
file_type = bin
variable = tmunu
dt = 0.001
