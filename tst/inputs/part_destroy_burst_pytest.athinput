# Death-ledger regression: a 32^3 lattice drains out through outflow boundaries, so
# particles are destroyed in MANY events of WIDELY DIFFERENT sizes (a >1000-particle
# burst followed by dozens of progressively smaller events). That sequence is what
# exercises nloc < capacity in Particles::FlushDeathLog: the death-record arrays are
# grow-only, so after a large event a later smaller event has fewer active records than
# the allocated capacity. On a separate-memory-space backend (HIP/CUDA) a column subview
# of those (7, cap) LayoutRight arrays is non-contiguous and cannot be mirrored to the
# host, which used to abort the run; on every backend the CSV must contain exactly the
# active records and never the capacity tail.

<comment>
problem = particle death-ledger burst regression

<job>
basename = part_destroy_burst

<mesh>
nghost = 2
nx1 = 32
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow

nx2 = 32
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow

nx3 = 32
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.3
nlim = 60
tlim = 10.0
ndiag = 1

<coord>
general_rel = true
minkowski = true
excise = false

<adm>

<particles>
particle_type = dust
pusher = drift
init = pgen
mass = 1.0
debug = 1
destroy_log = true

<problem>
mode = lattice
vmax = 1.0
audit = false
npx = 32
npy = 32
npz = 32

<output1>
file_type = pvtk
variable = prtcl_all
dt = 0.5
