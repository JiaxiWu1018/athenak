# Static-refinement regression for cross-rank particle Tmunu images. The refined root
# block [0,1]^3 becomes eight level-1 blocks. Tests place one particle at their shared
# corner (0.5,0.5,0.5), so its CIC cloud creates seven same-level neighbor images.

<comment>
problem = particle Tmunu static-refinement MPI regression

<job>
basename = part_tmunu_smr

<mesh>
nghost = 2
nx1 = 32
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 32
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3 = 32
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement = static

<refined_region1>
level = 1
x1min = 0.25
x1max = 0.75
x2min = 0.25
x2max = 0.75
x3min = 0.25
x3max = 0.75

<coord>
general_rel = true
minkowski = true
excise = false

<time>
evolution = dynamic
integrator = rk2
cfl_number = 0.25
nlim = 0
tlim = 1.0
ndiag = 1

<z4c>
diss = 0.0

<particles>
particle_type = dust
pusher = drift
init = pgen
mass = 1.0
feedback = true
debug = 1
destroy_log = false

<problem>
mode = single
px = 0.5
py = 0.5
pz = 0.5
pux = 1.0
puy = 1.0
puz = 1.0
pmass = 1.0

<output1>
file_type = bin
variable = tmunu
dt = 0.001
