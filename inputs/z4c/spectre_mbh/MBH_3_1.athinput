<comment>
problem   = A BH planetary system evolution of initial data generated by SpECTRE

<job>
basename  = MBH_3_1      # problem ID: basename of output filenames

<problem>
pgen_name = z4c_spectre_mbh
id_filename_glob = /scratch/10222/jiaxiwu1018/MBH_3_1/id_3_1_p2/PuncturesVolume*.h5
id_subfile_name = VolumeData
id_observation_step = -1
num_bhs = 5

<mesh>
nghost    = 4          # Number of ghost cells
nx1       = 128        # Number of zones in X1-direction
x1min     = -80       # minimum value of X1
x1max     = 80       # maximum value of X1
ix1_bc    = outflow   # inner-X1 boundary flag
ox1_bc    = outflow   # outer-X1 boundary flag

nx2       = 128        # Number of zones in X2-direction
x2min     = -80      # minimum value of X2
x2max     = 80       # maximum value of X2
ix2_bc    = outflow   # inner-X2 boundary flag
ox2_bc    = outflow   # outer-X2 boundary flag

nx3       = 128        # Number of zones in X3-direction
x3min     = -80       # minimum value of X3
x3max     = 80        # maximum value of X3
ix3_bc    = outflow   # inner-X3 boundary flag
ox3_bc    = outflow   # outer-X3 boundary flag

<meshblock>
nx1       = 32         # Number of cells in each MeshBlock, X1-dir
nx2       = 32         # Number of cells in each MeshBlock, X2-dir
nx3       = 32         # Number of cells in each MeshBlock, X3-dir

<time>
evolution  = dynamic    # dynamic/kinematic/static
integrator = rk4        # time integration algorithm
cfl_number = 0.5        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1          # cycle limit
tlim       = 10000        # time limit
ndiag      = 1          # cycles between diagnostic output

<mesh_refinement>
refinement       = adaptive    # type of refinement
max_nmb_per_rank = 800
num_levels       = 9
refinement_interval = 5

# amr chi method
<z4c_amr>
method = loehner
loehner_threshold = 0.1
loehner_variable = alp_psi7

<amr_criterion>
method = user # set to z4c amr in the pgen

<refined_region1>
level = 7
x1min = -0.625
x1max = 0.625
x2min = -0.625
x2max = 0.625
x3min = -0.625
x3max = 0.625

<refined_region2>
level = 7
x1min = 14.27638739
x1max = 14.90138739
x2min = -4.09478568
x2max = -3.46978568
x3min = -0.3125
x3max = 0.3125

<refined_region3>
level = 7
x1min = 16.5292318
x1max = 17.1542318
x2min = -3.16451902
x2max = -2.53951902
x3min = -0.3125
x3max = 0.3125

<refined_region4>
level = 7
x1min = 17.7875
x1max = 18.4125
x2min = -0.2125
x2max = 0.4125
x3min = -0.3125
x3max = 0.3125

<refined_region5>
level = 7
x1min = 13.57480854
x1max = 14.19980854
x2min = 2.21857449
x2max = 2.84357449
x3min = -0.3125
x3max = 0.3125

<z4c>
shift_driver = gamma_driver_B
lapse_harmonic  = 0.0                 # Harmonic lapse parameter mu_L
lapse_oplog     = 1.0                 # 1+log lapse parameter
const_damp      = false
shift_advect    = 0.0
shift_eta       = 2.0                 # Shift damping term
diss            = 0.25                 # Kreiss-Oliger dissipation parameter
chi_div_floor   = 0.00001
damp_kappa1     = 0.02      # Constraint damping factor 1
damp_kappa2     = 0.0

co_0_type = BH
co_0_x = 0.1
co_0_y = 0.1
co_0_z = 0.0
co_0_M = 0.78947368
co_1_type = BH
co_1_x = 14.58888739
co_1_y = -3.78228568
co_1_z = 0.0
co_1_M = 0.05263158
co_2_type = BH
co_2_x = 16.8417318
co_2_y = -2.85201902
co_2_z = 0.0
co_2_M = 0.05263158
co_3_type = BH
co_3_x = 18.1
co_3_y = 0.1
co_3_z = 0.0
co_3_M = 0.05263158
co_4_type = BH
co_4_x = 13.88730854
co_4_y = 2.53107449
co_4_z = 0.0
co_4_M = 0.05263158

# Wave extraction
nrad_wave_extraction = 3    # turn off GW
extraction_radius_0 = 30
extraction_radius_1 = 50
extraction_radius_2 = 80
extraction_nlev = 30
waveform_dt = 0.009765625

<output1>
file_type  = bin    # Binary data dump
variable   = z4c    # variables to be output
slice_x3   = 0.0    # xy plane at z=0
dt         = 1.0    # time increment between outputs

<output2>
file_type  = rst
dt         = 5.0

<output3>
file_type  = bin
variable   = con
slice_x3   = 0.0
dt         = 1.0

<output4>
file_type  = hst
dt         = 0.1
