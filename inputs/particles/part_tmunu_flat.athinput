# NRPIC Stage-4a Tmunu-deposition unit tests: exact Minkowski (z4c present as the
# feedback consumer; <coord> minkowski=true makes the analytic ADM background exactly
# flat, so sqrt(gamma)=1 and the python-side per-cell CIC predictions are exact).
# Strictly periodic 32^3 domain in 2x2x2 MeshBlocks of 16^3. nlim=0: the driver-seed
# deposit runs, the initial outputs are written, and the run ends -- a pure deposition
# test with no evolution. <particles> debug=1 arms the in-code float64 conservation
# identity (fatal on violation): the machine-eps gate of the 4a suite.
#
# Suite CLI overrides (keys must exist here -- the CLI cannot ADD keys):
#   problem/mode      = single | sweep
#   problem/sweep_x1..x3 = 0.0 (interior block corner) | -0.5 (domain corner -> wrap)
#   meshblock/nx1..3  = 32 (single-block reference run for the cross-block comparison)
#   problem/pux..z    = 0.0 (W=1) | 1.0 each (W=2 exactly in flat space)

<comment>
problem   = particle Tmunu deposition test (flat)

<job>
basename  = part_tmunu_flat

<mesh>
nghost    = 2
nx1       = 32
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 32
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 32
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 16
nx2       = 16
nx3       = 16

<coord>
general_rel = true     # enables the <coord> metric keys (Stage-2 gotcha)
minkowski   = true     # exact flat ADM background (H = 0, no spin key needed)
excise      = false

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.25
nlim       = 0         # seed deposit + initial outputs only (no evolution)
tlim       = 1.0
ndiag      = 1

<z4c>
diss       = 0.0       # irrelevant at nlim=0; present so the block exists

<particles>
particle_type = dust
pusher    = drift
init      = pgen
mass      = 1.0
feedback  = true       # deposit particle stress-energy into Tmunu
debug     = 1          # fatal in-code conservation-identity check every deposit
destroy_log = false

<problem>
mode      = single     # single | sweep (CLI-overridable)
px        = 0.171875   # single-mode position (a generic interior point)
py        = 0.078125
pz        = -0.140625
pux       = 0.0        # common covariant velocity u_i (1,1,1 -> W=2 exactly in flat)
puy       = 0.0
puz       = 0.0
pmass     = 1.0
sweep_x1  = 0.0        # sweep anchor: interior block corner of the 2x2x2 decomposition
sweep_x2  = 0.0        #   (override to -0.5 = domain corner for the periodic-wrap test)
sweep_x3  = 0.0
sweep_dx  = 0.03125    # cell width h = 1/32
sweep_span = 0.5       # distance from the anchor to the far face of the anchored block

<output1>
file_type  = bin
variable   = tmunu
dt         = 0.001

<output2>
file_type  = bin
variable   = adm
dt         = 0.001

<output3>
file_type  = pvtk
variable   = prtcl_all
dt         = 0.001
