# NRPIC Stage-3 particle migration test: UNIFORM grid (2x2x2 MeshBlocks), strictly
# periodic. mode=targeted places one particle per (MeshBlock, neighbor slot) aimed to
# cross that face/edge/corner in ONE cycle; <particles> debug=1 makes any wrong
# destination fatal. Run with time/nlim=1 for the targeted test, larger nlim as a soak.
# Tag decode: tag = gid*56 + slot, slot = NeighborIndex(ix,iy,iz,f1,f2).

<comment>
problem   = particle MeshBlock-crossing test (uniform)

<job>
basename  = part_crossing_uniform

<mesh>
nghost    = 2
nx1       = 16        # 2 MeshBlocks in each direction
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 16
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 16
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = 1         # ONE targeted crossing step (raise for a soak run)
tlim       = 10.0
ndiag      = 1

<particles>
particle_type = dust
pusher = drift
init   = pgen          # pgen (in-code targeted/lattice) | file (HDF5 lattice twin)
prtcl_init_file = lattice.h5   # used only when init=file (key present for CLI override)
debug  = 1             # fatal post-migration validation (the pass/fail criterion)
destroy_log   = true   # death-record CSV (<basename>.prtcl_destroy.csv)
excise_radius = 0.0    # > 0 enables sphere excision (keys present for CLI override)
excise_x1     = 0.0    # sphere center
excise_x2     = 0.0
excise_x3     = 0.0
excise_lapse  = 0.0    # > 0 enables lapse excision (requires <adm>; gauge-dependent)

<problem>
mode        = targeted # targeted (slot enum) | lattice (soak) | random (fuzz)
vmax        = 1.0      # particle speed
audit       = false    # exhaustive destination-search audit vs bbox oracle (fatal)
delta_frac  = 0.1      # targeted inward offset / min cell (0 = exactly ON boundary)
select_gid  = -1       # targeted-mode isolation filters (-1 = all)
select_slot = -1
nrand       = 64       # random-mode particles per MeshBlock
seed        = 1        # random-mode RNG seed (re-seeded per block: seed + 7919*gid)
npx         = 8        # lattice-mode resolution
npy         = 8
npz         = 8

<output1>
file_type   = pvtk
variable    = prtcl_all
dt          = 0.001    # smaller than the cycle dt -> dump every cycle
