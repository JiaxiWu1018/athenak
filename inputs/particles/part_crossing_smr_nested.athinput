# NRPIC Stage-3 particle migration test: THREE-LEVEL nested SMR. Level 1 covers the
# x<0 half-domain; level 2 covers the (-,-,-) octant inside it; the tree's 2:1 balance
# adds level-1 padding where level 2 would touch level 0. Middle-level blocks are
# simultaneously FINE (vs level 0) and COARSE (vs level 2), exercising compound
# parity/demotion cases. One particle per (MeshBlock, neighbor slot); debug=1 fatal.
# Tag decode: tag = gid*56 + NeighborIndex(ix,iy,iz,f1,f2).
<comment>
problem   = particle MeshBlock-crossing test (smr_nested)

<job>
basename  = part_crossing_smr_nested

<mesh>
nghost    = 2
nx1       = 16        # 2 MeshBlocks in each direction
x1min     = -0.5
x1max     = 0.5
ix1_bc    = periodic
ox1_bc    = periodic

nx2       = 16
x2min     = -0.5
x2max     = 0.5
ix2_bc    = periodic
ox2_bc    = periodic

nx3       = 16
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<mesh_refinement>
refinement = static

<refined_region1>
level = 1
x1min = -0.5
x1max = 0.0
x2min = -0.5
x2max = 0.5
x3min = -0.5
x3max = 0.5

<refined_region2>
level = 2
x1min = -0.5
x1max = 0.0
x2min = -0.5
x2max = 0.0
x3min = -0.5
x3max = 0.0

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.8
nlim       = 1         # ONE targeted crossing step (raise for a soak run)
tlim       = 10.0
ndiag      = 1

<particles>
particle_type = dust
pusher = drift
init   = pgen          # pgen (in-code targeted/lattice) | file (HDF5 lattice twin)
prtcl_init_file = lattice.h5   # used only when init=file (key present for CLI override)
debug  = 1             # fatal post-migration validation (the pass/fail criterion)

<problem>
mode        = targeted # targeted (slot enum) | lattice (soak) | random (fuzz)
vmax        = 1.0      # particle speed
audit       = false    # exhaustive destination-search audit vs bbox oracle (fatal)
delta_frac  = 0.1      # targeted inward offset / min cell (0 = exactly ON boundary)
select_gid  = -1       # targeted-mode isolation filters (-1 = all)
select_slot = -1
nrand       = 64       # random-mode particles per MeshBlock
seed        = 1        # random-mode RNG seed (re-seeded per block: seed + 7919*gid)
npx         = 8        # lattice-mode resolution
npy         = 8
npz         = 8

<output1>
file_type   = pvtk
variable    = prtcl_all
dt          = 0.001    # smaller than the cycle dt -> dump every cycle
