<comment>
problem   = NRPIC Stage-2: dust geodesic in a Schwarzschild-Kerr-Schild background
reference = gr_boris pusher validation (q=0 geodesic limit), spin a=0, mass M=1

# A single dust particle (q=0) on a static analytic Cartesian Kerr-Schild metric. The
# gr_boris pusher reduces to the geodesic integrator. Validation (stationary spacetime):
#   circular orbit : areal radius r stays constant; E=-u_t and L=u_phi conserved.
#   radial infall  : IPEN = alpha(r0) conserved as the particle falls inward.
# Build: cmake -S . -B build -DAthena_ENABLE_MPI=ON -DAthena_ENABLE_HDF5=ON \
#              -DPROBLEM=particles/part_kerr_schild
# IC (circular r0=10): python scripts/particles/gen_geodesic_orbit.py \
#              --mode circular --a 0.0 --r0 10 --out part_schw_ic.h5
# Run: ./build/src/athena -i inputs/particles/part_schwarzschild.athinput

<job>
basename = schw_geodesic

<mesh>
nghost = 4
nx1    = 64
x1min  = -12.0
x1max  = 12.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 64
x2min  = -12.0
x2max  = 12.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 64
x3min  = -12.0
x3max  = 12.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 64
nx2 = 64
nx3 = 64

<time>
evolution  = dynamic
integrator = rk2
cfl_number = 0.3
nlim       = 1000000
tlim       = 400.0       # ~2 circular orbits at r0=10 (T = 2*pi*sqrt(r^3/M) ~ 198.7)
ndiag      = 200

<coord>
general_rel = true       # needed so the spin parameter `a` is read into bh_spin
excise      = false      # no hydro excision (particle-only background)
a           = 0.0        # Schwarzschild
minkowski   = false

<adm>

<particles>
particle_type   = dust
pusher          = gr_boris
init            = file
prtcl_init_file = part_schw_ic.h5
mass            = 1.0

<output1>
file_type = pvtk
variable  = prtcl_all
dt        = 2.0
