<comment>
Session-005 Arm B capability experiment. Same accepted Session-004 physical model:
M_env=0.76, R0=30, two identical cold M=0.12 clumps at x=+-3, zero bulk/orbital
velocity, and 5,000,000 particles in the required 3:1:1 ratio. Continuum ADM mass 1.

Fresh t=0 start in the accepted [-128,128]^3 box, root dx=2. Seed regions initially
reach dx=1/64, but tracker_floor=false: only Lohner(alpha psi^7, threshold 0.2)
controls their later refinement/derefinement. num_levels=11 permits dx_min=1/512.

AH particle excision is on and lapse excision is off. FastFlow capability surfaces
ignore the resolution, normalized-expansion, and persistence quality gates; those
remain diagnostics only. This aggressive arm is not a precision collapse/BH solution.

<job>
basename = s5_arm_b_aggressive_ah

<mesh>
nghost = 4
nx1 = 128
x1min = -128.0
x1max = 128.0
ix1_bc = outflow
ox1_bc = outflow
nx2 = 128
x2min = -128.0
x2max = 128.0
ix2_bc = outflow
ox2_bc = outflow
nx3 = 128
x3min = -128.0
x3max = 128.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = 100000000
tlim = 10.0
ndiag = 50

<mesh_refinement>
refinement = adaptive
num_levels = 11
max_nmb_per_rank = 240
ncycle_check = 16
refinement_interval = 16

<amr_criterion1>
method = user

<z4c_amr>
method = loehner
tracker_floor = false
loehner_variable = alp_psi7
loehner_threshold = 0.2
radius_0_rad = 34.0
radius_0_reflevel = 1
radius_1_rad = 18.0
radius_1_reflevel = 2
radius_2_rad = 15.0
radius_2_reflevel = 3

<refined_region1>
level = 1
x1min = -34
x1max = 34
x2min = -34
x2max = 34
x3min = -34
x3max = 34

<refined_region2>
level = 2
x1min = -18
x1max = 18
x2min = -18
x2max = 18
x3min = -18
x3max = 18

<refined_region3>
level = 3
x1min = -15
x1max = 15
x2min = -15
x2max = 15
x3min = -15
x3max = 15

<refined_region4>
level = 4
x1min = -6
x1max = 0
x2min = -3
x2max = 3
x3min = -3
x3max = 3

<refined_region5>
level = 5
x1min = -4.5
x1max = -1.5
x2min = -1.5
x2max = 1.5
x3min = -1.5
x3max = 1.5

<refined_region6>
level = 6
x1min = -3.75
x1max = -2.25
x2min = -0.75
x2max = 0.75
x3min = -0.75
x3max = 0.75

<refined_region7>
level = 7
x1min = -3.375
x1max = -2.625
x2min = -0.375
x2max = 0.375
x3min = -0.375
x3max = 0.375

<refined_region8>
level = 4
x1min = 0
x1max = 6
x2min = -3
x2max = 3
x3min = -3
x3max = 3

<refined_region9>
level = 5
x1min = 1.5
x1max = 4.5
x2min = -1.5
x2max = 1.5
x3min = -1.5
x3max = 1.5

<refined_region10>
level = 6
x1min = 2.25
x1max = 3.75
x2min = -0.75
x2max = 0.75
x3min = -0.75
x3max = 0.75

<refined_region11>
level = 7
x1min = 2.625
x1max = 3.375
x2min = -0.375
x2max = 0.375
x3min = -0.375
x3max = 0.375

<z4c>
lapse_harmonicf = 1.0
lapse_harmonic = 0.0
lapse_oplog = 2.0
lapse_advect = 1.0
shift_eta = 2.0
shift_advect = 1.0
diss = 0.1
chi_div_floor = 0.00001
damp_kappa1 = 0.02
damp_kappa2 = 0.0
tracker_mode = walk
tracker_walk_every = 16
co_0_type = BH
co_0_x = -3
