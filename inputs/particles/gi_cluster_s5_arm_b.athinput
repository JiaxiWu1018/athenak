co_8_radius = 0.375
co_8_reflevel = 7
co_8_out_every = 20
co_9_type = BH
co_9_x = 3
co_9_y = 0
co_9_z = 0
co_9_mass = 0.12
co_9_radius = 0.1875
co_9_reflevel = 7
co_9_out_every = 20

<fastflow>
npunct = 10
num_horizons = 2
ntheta = 10
lmax = 6
expand_guess = 1.0
output_ylm = true
output_grid = false
verbose = true
consumer_rmin_0 = 0.0
consumer_rmin_1 = 0.0
consumer_rmin_cells_0 = 4.0
consumer_rmin_cells_1 = 4.0
consumer_rmax_0 = 0.1875
consumer_rmax_1 = 0.1875
consumer_hrel_0 = 0.2
consumer_hrel_1 = 0.2
consumer_persist_0 = 3
consumer_persist_1 = 3
consumer_capability_mode_0 = true
consumer_capability_mode_1 = true
capability_rmax_0 = 0.75
capability_rmax_1 = 0.75
capability_center_jump_0 = 0.5
capability_center_jump_1 = 0.5
use_puncture_0 = 0
initial_radius_0 = 0.06
flow_iterations_0 = 200
flow_alpha_beta_const_0 = 0.005
hmean_tol_0 = 100.0
mass_tol_0 = 1e-4
start_time_0 = 2.5
stop_time_0 = 30.0
use_puncture_1 = 5
initial_radius_1 = 0.06
flow_iterations_1 = 200
flow_alpha_beta_const_1 = 0.005
hmean_tol_1 = 100.0
mass_tol_1 = 1e-4
start_time_1 = 2.5
stop_time_1 = 30.0

<particles>
particle_type = dust
pusher = gr_boris
fatal_boris_reject = true
init = pgen
feedback = true
mass = 1.0
debug = 1
destroy_log = true
excise_radius = 0.0
excise_lapse = 0.0
excise_lapse_raw_ah = false
excise_ah = true
cross_level_deposit = conservative

<problem>
gi_m0 = 0.76
gi_r0 = 30.0
gi_n_env = 3000000
gi_n_clump = 2000000
gi_seed = 4001
gi_profile_dr = 0.001
gi_nclumps = 2
gi_clump_mass_scale = 1.0
gi_dump_profile = gi_profile_M076_two_clump.txt

<output1>
file_type = hst
dt = 0.05

<output2>
file_type = bin
variable = tmunu
slice_x3 = 0.0
dt = 0.1

<output3>
file_type = bin
variable = con
slice_x3 = 0.0
dt = 0.1

<output4>
file_type = bin
variable = z4c
slice_x3 = 0.0
dt = 0.05

<output5>
file_type = pvtk
variable = prtcl_all
dt = 0.25

<output6>
file_type = bin
variable = tmunu_E
id = E3d
dt = 2.0

<output7>
file_type = rst
dt = 0.25

<output8>
file_type = cbin
variable = z4c_chi
id = mesh
coarsen_factor = 32
dt = 0.05
