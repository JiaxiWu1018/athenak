<comment>
problem = Paper Session 02 performance benchmark sampling_central1_R1
<job>
basename = sampling_central1_R1
<mesh>
nghost = 4
nx1 = 64
x1min = -12
x1max = 12
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -12
x2max = 12
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -12
x3max = 12
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32
<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.13333333333333333
tlim = 5
nlim = 100
ndiag = 10
<z4c>
frozen_background = false
use_z4c = true
lapse_harmonic = 0.0
lapse_oplog = 2.0
shift_driver = legacy
shift_Gamma = 1.0
shift_H = 0.0
shift_alpha2Gamma = 0.0
shift_eta = 2.0
diss = 0.1
chi_div_floor = 0.00001
damp_kappa1 = 0.02
damp_kappa2 = 0.0
<particles>
particle_type = dust
pusher = gr_boris
init = pgen
feedback = true
mass = 1.0
debug = 0
destroy_log = false
excise_radius = 0.0
excise_lapse = 0.0
excise_ah = false
cross_level_deposit = conservative
<fastflow>
num_horizons = 0
<benchmark>
enabled = true
profile = false
mesh_only = false
metric = st
sampling = replicas
distribution = central1
yc = 0.819
seed = 1
n = 6291456
ppc = 24
warmup = 0.5
