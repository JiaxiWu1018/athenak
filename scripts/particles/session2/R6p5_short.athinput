# =============================================================================
# NRPIC relativistic PLUMMER Einstein cluster -- SESSION 2 compactness scan
# case R6p5: (R/M)_eff = 1/max_r[m(r)/r] = 6.5  (target 6.5)
# variant: short
#
# GENERATED by scripts/make_session2_inputs.py -- do not hand-edit.  Every number
# below is derived from analysis/plummer_1d.py; --check re-derives and diffs.
#
# QUESTION.  Session 1 ran this Plummer family at (R/M)_eff = 51.77 (b = 20 M) and
# found the cluster globally close to equilibrium for 3 P_1/2 with a slow, weak,
# CENTRE-OF-MASS-REFERENCED l = 1 signal confined to the inner mass quartile -- far
# weaker than the homogeneous Einstein cluster's whole-object dipole instability.
# Session 2 makes the SAME family substantially more relativistic and asks whether
# it stays broadly stable, keeps only the weak core-local mode, or crosses over to
# a strong collective l = 1 instability.  This deck does not presuppose an answer.
#
# CONTINUUM MODEL (G = c = 1).  The STATIC-OBSERVER energy density
# eps = T_{mu nu} n^mu n^nu is Plummer in AREAL radius r, hard-cut at r_t with
# vacuum outside and no taper, renormalised so M_ADM = 1 exactly.  The truncation
# convention r_t/b = 20 is held fixed across the scan, which makes f_t independent
# of b and the compactness exactly linear in b:
#   max(m/r) = 2 M_P/(3 sqrt(3) b) at r = b sqrt(2)  =>  (R/M)_eff = 3 sqrt(3) b f_t/2.
#
#   b            = 2.51123896963546 M
#   r_t = 20 b   = 50.2247793927091 M
#   f_t          = 0.996261684666179   (removed mass fraction 0.373832 %)
#   M_P = M/f_t  = 1.00375234277435
#   M_0          = 1.04976569178028   (total REST mass; N mu = M_0 != M_ADM, binding energy)
#   mu = M_0/N   = 4.96686922664332e-07
#   r_1/2        = 3.26556671795185 M      R_1/2 = 2.44463906806456 M (isotropic)
#   R_t          = 49.2197001256806 M (isotropic)
#   alpha(r_1/2) = 0.734842876298        v_c(r_1/2) = 0.469782218105
#   P_1/2        = 59.4356979525812 M      5 P_1/2 = 297.178489762906 M
#   alpha(0)     = 0.602881108165        psi(0) = 1.26835582336
#   max m/r      = 0.153846153846154  (<< 1/3: circular geodesics exist everywhere)
#   max v_c      = 0.471404520791 at r = 3.55142820922 M
#   minimum lapse= 0.602881108165
#
# PRE-PRODUCTION CHECKS (analysis/solve_compactness.py, all PASS):
#   circular geodesic exists everywhere      max m/r < 1/3
#   individual circular orbit radially stable r^2 m' + r m - 6 m^2 > 0 everywhere
#   no horizon / regular geometry            max 2m/r < 1, min alpha > 0
#   continuum constraint identities          < 1e-12 relative
#
# SAMPLING.  Unchanged from Session 1: stratified antithetic, N_pair = 1056768
# co-located +/-u_i pairs, N = 2113536 equal-rest-mass particles, seed 1985.
# Initial deposited momentum and total angular momentum vanish EXACTLY by pair
# cancellation, and the initial radial velocity dispersion is zero.
# The A_l finite-N noise floor is set by the number of INDEPENDENT ANGULAR
# POSITIONS, N_pair, NOT by N:
#   A_l^shot(global)   = N_pair^-1/2      = 9.727700099448e-04
#   A_l^shot(quartile) = (N_pair/4)^-1/2  = 1.945540019890e-03
#
# MESH.  [-768,768]^3, root 128^3 (dx_0 = 12 M), MeshBlocks 32^3, nghost 4,
# 7 static refined levels at block-aligned half-widths
#   384/192/96/48/24/12/6 M
# -> dx_fine = 0.09375 M.  Leaf count 7*56 + 64 = 456 MeshBlocks = 14,942,208 active cells.
# Resolution 26.79 cells per Plummer scale b, 34.83 per r_1/2 (areal), 26.08 per
# R_1/2 (isotropic, the MESH coordinate).  Session 1 had 20.00 / 26.01 / 25.21,
# so every resolution measure here meets or exceeds the Session-1 baseline and
# both Session-2 mandated minima (>= 20 per b, >= 26 per r_1/2).
# Nominal dt = CFL*dx_fine = 0.0234375 M; the code also applies the PARABOLIC bound of
# the Hamiltonian-constraint damping, dt_par = safety*s_RK*dx^2/(3 sigma c_H psi_max)
# (z4c_newdt.cpp).  At t = 0, psi_max = psi(0) = 1.26836 gives dt_par/dt_hyp = 1.135,
# so the hyperbolic bound controls -- but only by that factor, and psi_max is
# re-evaluated every cycle, so a contraction can hand control to the parabolic
# bound and shrink dt.  The startup banner prints which bound controls; the code
# prints a NOTE the first cycle the parabolic bound takes over.  MONITOR IT.
#
# CAUSALITY.  The 1+log gauge speed is sqrt(2/alpha) ~ sqrt(2). A disturbance
# launched at the outer boundary R = 768 M reaches the matter edge R_t = 49.2197 M
# after >= (768 - 49.2197)/sqrt(2) = 508.254 M = 8.55 P_1/2 (and 6.64 P_1/2 using the
# ultra-conservative sqrt(2/alpha_min)), i.e. AFTER the 5 P_1/2 endpoint.
# Session 1 could not say this: its boundary signal arrived at 2.19 P_1/2, before
# its own 3 P_1/2 endpoint.  The extra refinement level here buys that margin.
#
# IN-CODE LEDGERS at the hst cadence, reduced over ALL particles/cells in double
# precision (see src/pgen/particles/nr_pic_plummer.cpp):
#   .plummer_shells.csv   48 log bins in areal radius over [0.062781, 100.45] M:
#                         mass, <r>, <v_r>, dispersions, <alpha W>, <|L|>, and real
#                         Y_lm moments to l = 4 about the ORIGIN (c_lm) and about
#                         the instantaneous CENTRE OF MASS (d_lm).  d_lm is primary.
#   .plummer_cohorts.csv  32 LAGRANGIAN equal-rest-mass initial radial bands.
#   .plummer_fields.csv   64 log bins in ISOTROPIC radius over [0.09375, 1536] M:
#                         |H|, H^2, M^2, alpha, chi, deposited E, areal radius,
#                         Khat, plus the cell size, so a refinement seam, the
#                         density cutoff or a boundary feature is identifiable.
#   .plummer_admmom.csv   NEW in Session 2: the ADM linear momentum
#                         P_i = (1/8pi) oint dS_m (K^m_i - delta^m_i K) on 6
#                         coordinate spheres, with the particle momentum sum
#                         P_i^matter = sum_p m_p u_i and the deposited
#                         P_i^dep = int S_i sqrt(gamma) d^3x for reconciliation.
#
# The truncation sits close to a refinement seam in this scan (the nearest seam is
# 1.22 M from R_t). The deposited energy density there is (1+(r_t/b)^2)^-5/2 ~ 3e-7
# of central and no mass lies beyond it, so a prolongation feature there cannot
# reach the core bands; the fields ledger resolves the seam explicitly so the claim
# is checkable rather than asserted.
#
# NO trk OUTPUT.  file_type = trk stays DISABLED (Session 1 found the writer reads
# past the end of a host array and produced a 94.9 GB file in 150 M).
# EXCISION IS OFF; no particle should ever be removed.
# =============================================================================

<comment>
problem = NRPIC relativistic Plummer Einstein cluster SESSION 2 R6p5: (R/M)_eff=6.5 b=2.51123896964M rt=50.2247793927M N=2113536 seed=1985 stratified-antithetic BSSN use_z4c=false cH=0.02 filter=OFF dxf=0.09375 (pl_R6p5_b2p5112_s1985_pf_short)

<job>
basename = pl_R6p5_b2p5112_s1985_pf_short

<mesh>
nghost = 4
nx1    = 128
x1min  = -768.0
x1max  = 768.0
ix1_bc = outflow
ox1_bc = outflow
nx2    = 128
x2min  = -768.0
x2max  = 768.0
ix2_bc = outflow
ox2_bc = outflow
nx3    = 128
x3min  = -768.0
x3max  = 768.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<mesh_refinement>
refinement       = static
# max_nmb_per_rank is consulted only for ADAPTIVE refinement; with
# refinement = static the code reports it as unused, so it is deliberately absent.

<refined_region1>
level = 1
x1min = -384.0
x1max = 384.0
x2min = -384.0
x2max = 384.0
x3min = -384.0
x3max = 384.0

<refined_region2>
level = 2
x1min = -192.0
x1max = 192.0
x2min = -192.0
x2max = 192.0
x3min = -192.0
x3max = 192.0

<refined_region3>
level = 3
x1min = -96.0
x1max = 96.0
x2min = -96.0
x2max = 96.0
x3min = -96.0
x3max = 96.0

<refined_region4>
level = 4
x1min = -48.0
x1max = 48.0
x2min = -48.0
x2max = 48.0
x3min = -48.0
x3max = 48.0

<refined_region5>
level = 5
x1min = -24.0
x1max = 24.0
x2min = -24.0
x2max = 24.0
x3min = -24.0
x3max = 24.0

<refined_region6>
level = 6
x1min = -12.0
x1max = 12.0
x2min = -12.0
x2max = 12.0
x3min = -12.0
x3max = 12.0

<refined_region7>
level = 7
x1min = -6.0
x1max = 6.0
x2min = -6.0
x2max = 6.0
x3min = -6.0
x3max = 6.0

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25
nlim       = 100000000
tlim       = 7.42946224407265
ndiag      = 100

<z4c>
# Verbatim from the Session-1 production deck: the compactness scan changes
# compactness, not the formulation, gauge, damping or dissipation.
lapse_harmonic    = 0.0
lapse_harmonicf   = 1.0
lapse_oplog       = 2.0
lapse_advect      = 1.0
shift_driver      = legacy
shift_eta         = 2.0
shift_advect      = 1.0
shift_Gamma       = 1.0
shift_alpha2Gamma = 0.0
shift_H           = 0.0
const_damp        = true
diss              = 0.1
chi_div_floor     = 0.00001
use_z4c           = false
hdamp_cH          = 0.02
hdamp_par_safety  = 0.5
damp_kappa1       = 0.0
damp_kappa2       = 0.0
nrad_wave_extraction = 0

<particles>
# Verbatim from the Session-1 production deck.
particle_type       = dust
pusher              = gr_boris
init                = pgen
feedback            = true
mass                = 1.0
debug               = 0
destroy_log         = true
excise_radius       = 0.0
excise_x1           = 0.0
excise_x2           = 0.0
excise_x3           = 0.0
excise_lapse        = 0.0
excise_ah           = false
cross_level_deposit = conservative
tmunu_filter_passes   = 0

<problem>
user_hist            = true
plummer_mass         = 1.0
# plummer_b AND plummer_rt must BOTH be set: each is GetOrAdd with a Session-1
# default (20.0 and 400.0), so omitting rt would silently build an rt/b != 20
# cluster with a different f_t and a different (R/M)_eff, with no warning.
plummer_b            = 2.5112389696354551
plummer_rt           = 50.224779392709102
plummer_npair        = 1056768
plummer_seed         = 1985
plummer_ntable       = 20000
plummer_nmetric      = 16384
plummer_metric_R0    = 0.0615246251571
plummer_center_x1    = 0.0
plummer_center_x2    = 0.0
plummer_center_x3    = 0.0
# Ledger ranges scaled from Session 1 so the log-bin GEOMETRY is identical:
# shells over [0.025 b, 40 b] (Session 1: [0.5, 800] M at b = 20 M), fields over
# [dx_fine, 2 L] (Session 1: [0.5, 8192] M at dx_fine = 1 M, L = 4096 M).
plummer_shell_nbin   = 48
plummer_shell_rmin   = 0.0627809742409
plummer_shell_rmax   = 100.449558785
plummer_cohort_nbin  = 32
plummer_lmax         = 4
plummer_field_nbin   = 64
plummer_field_rmin   = 0.09375
plummer_field_rmax   = 1536

# ---- ADM linear momentum (Session 2).  Extraction spheres are coordinate spheres
#      R = const; all lie in vacuum outside R_t = 49.2197 M, each between two
#      refinement seams (384/192/96/48/24/12/6 M), and they span a factor 5 in radius across three
#      refinement levels so radius-independence is testable.
#      selftest = 1 runs the Bowen-York positive unit test at startup and is FATAL
#      on failure; t = 0 is static so K_ij == 0 and P_i must vanish there too.
plummer_pmom_nrad    = 6
plummer_pmom_ntheta  = 32
plummer_pmom_selftest = 1
plummer_pmom_r1       = 60.0   # level 3, dx = 1.5, R/dx = 40.0
plummer_pmom_r2       = 84.0   # level 3, dx = 1.5, R/dx = 56.0
plummer_pmom_r3       = 120.0   # level 2, dx = 3, R/dx = 40.0
plummer_pmom_r4       = 150.0   # level 2, dx = 3, R/dx = 50.0
plummer_pmom_r5       = 240.0   # level 1, dx = 6, R/dx = 40.0
plummer_pmom_r6       = 300.0   # level 1, dx = 6, R/dx = 50.0

# ---- outputs.  P_1/2 = 59.4356979525812 M.  Every cadence is an exact fraction of P_1/2,
#      so t = n P_1/2 always lands on a written row and the per-period milestone
#      analysis has data exactly at each milestone.
#      binslice P/25    = 2.3774279181 M
#      cart     P/50    = 1.18871395905 M
#      cbin     P/5     = 11.8871395905 M
#      hst      P/200   = 0.297178489763 M
#      pvtk     P/100   = 0.594356979526 M
#      rst      P/4     = 14.8589244881 M

<output1>
file_type   = hst
dt          = 0.297178489763
data_format = %.17e

<output2>
file_type = pvtk
variable  = prtcl_all
dt        = 0.594356979526

# Movie B lives on a FIXED UNIFORM CARTESIAN grid, not on AMR patches: the same
# physical extent and the same pixel size in every frame, so nothing in the image
# can change because the refinement layout changed.
#
# NODE PLACEMENT IS DELIBERATE.  cart_grid.cpp decides which rank owns a node with
# a bounds test that is INCLUSIVE at both ends, and cartgrid.cpp MPI_SUMs the
# result, so a node lying exactly on a MeshBlock face shared by two ranks is
# DOUBLED.  On this origin-centred mesh the planes x = 0, y = 0 and z = 0 are
# MeshBlock faces at every level, so:
#   * center_x/y are offset by a NON-DYADIC fraction of dx_fine, moving every
#     node off the x = 0 and y = 0 faces and off every seam;
#   * the equatorial plane is sampled as TWO planes at z = +/- pixel/2 rather than
#     one plane at z = 0 (numpoints_z = 2, extent_z = pixel/2).  Their mean is the
#     z = 0 field to O(pixel^2) and neither plane is on a face.  numpoints_z = 2
#     with extent_z = 0 would be arithmetically safe (d_x3 = 0/1 = 0) but puts
#     both planes ON the z = 0 face, i.e. exactly the doubling case;
#     numpoints_z = 1 is silently broken (d_x3 = 0/0 = NaN).
# The preflight verifies this by differencing a 1-rank and a 4-rank t = 0 frame:
# any double-claimed node shows up as an exact factor 2.

<output3>
file_type   = cart
variable    = tmunu_E
id          = dens_wide
dt          = 1.18871395905
center_x    = 0.0290625
center_y    = 0.0290625
center_z    = 0.0
extent_x    = 60
extent_y    = 60
extent_z    = 0.375
numpoints_x = 161
numpoints_y = 161
numpoints_z = 2
chebyshev   = false
#           pixel = 0.75 M = 8 dx_fine = 0.2987 b; z planes at +0.375;
#           covers the matter edge (R_t = 49.2197 M, finest region half-width 6 M)

<output4>
file_type   = cart
variable    = con_H
id          = ham_wide
dt          = 1.18871395905
center_x    = 0.0290625
center_y    = 0.0290625
center_z    = 0.0
extent_x    = 60
extent_y    = 60
extent_z    = 0.375
