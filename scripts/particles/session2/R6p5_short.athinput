# AMR-patch slices, kept at a reduced cadence purely as a cross-check that the
# uniform-grid movie product agrees with the data on the mesh it came from.
<output7>
file_type = bin
variable  = con
slice_x3  = 0.0
dt        = 2.3774279181

<output8>
file_type = bin
variable  = tmunu
slice_x3  = 0.0
