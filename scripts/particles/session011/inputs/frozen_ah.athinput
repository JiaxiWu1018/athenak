<job>
basename = frozen_ah
<mesh>
nghost = 4
nx1 = 64
nx2 = 64
nx3 = 64
x1min = -2
x1max = 2
x2min = -2
x2max = 2
x3min = -2
x3max = 2
ix1_bc = outflow
ox1_bc = outflow
ix2_bc = outflow
ox2_bc = outflow
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<mesh_refinement>
refinement = static
max_nmb_per_rank = 64
<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = 0
tlim = 1
<z4c>
tracker_mode = ode
co_0_type = BH
co_0_x = 0.125
co_0_y = 0
co_0_z = 0
co_0_mass = 1
<particles>
particle_type = dust
pusher = gr_boris
init = pgen
feedback = false
mass = 0.001
excise_lapse = 0
<problem>
punc_ADM_mass = 1
punc_center_x1 = 0.125
prtcl_np = 32
prtcl_r1 = 1
prtcl_r2 = 0
<fastflow>
npunct = 1
num_horizons = 2
ntheta = 10
lmax = 6
verbose = false
use_puncture_0 = 0
use_puncture_1 = -1
use_puncture_massweighted_center_1 = true
wait_until_punc_are_close_1 = false
reuse_last_surface_shape_0 = true
persist_surface_shape_0 = true
consumer_rmin_cells_0 = 4
consumer_rmax_0 = 1
consumer_hrel_0 = 0.2
consumer_persist_0 = 3
initial_radius_0 = 0.5
flow_iterations_0 = 300
flow_alpha_beta_const_0 = 0.005
mass_tol_0 = 1e-4
start_time_0 = 0
stop_time_0 = 1
reuse_last_surface_shape_1 = true
persist_surface_shape_1 = true
consumer_rmin_cells_1 = 4
consumer_rmax_1 = 1
consumer_hrel_1 = 0.2
consumer_persist_1 = 3
initial_radius_1 = 0.5
flow_iterations_1 = 300
flow_alpha_beta_const_1 = 0.005
mass_tol_1 = 1e-4
start_time_1 = 0
stop_time_1 = 1
<diagnostic_checks>
frozen_ah_searches = 6
require_accept = true
<gi_diagnostics>
enabled = true
<output1>
file_type = trk
nparticles = 8
format_version = 2
dt = 0.25
<output2>
file_type = rst
dt = 1
