x2max = 1
x3min = -1
x3max = 1
<fastflow>
npunct = 0
num_horizons = 1
ntheta = 10
lmax = 6
use_puncture_0 = -1
initial_radius_0 = 1
expand_guess = 1
reuse_last_surface_shape_0 = true
persist_surface_shape_0 = true
consumer_rmin_0 = 0
consumer_rmin_cells_0 = 4
consumer_rmax_0 = 4
consumer_hrel_0 = 0.2
consumer_persist_0 = 3
flow_iterations_0 = 400
flow_alpha_beta_const_0 = 0.005
hmean_tol_0 = 100
mass_tol_0 = 0.0001
start_time_0 = 0
stop_time_0 = 40
diagnostic_dt = 0.025
verbose = false
output_ylm = true
output_grid = false
<particles>
particle_type = dust
pusher = gr_boris
init = pgen
feedback = true
mass = 1
debug = 1
destroy_log = true
excise_radius = 0
excise_lapse = 0.05
excise_ah = false
cross_level_deposit = conservative
orbit_diagnostic_dt = 0.025
<problem>
os_mass = 1
os_radius_over_mass = 5
os_lattice_n = 32
os_precollapsed_lapse = false
<output1>
file_type = rst
dt = 5
<output2>
file_type = hst
dt = 0.025
<output3>
file_type = bin
variable = z4c
id = metric
slice_x3 = 0
dt = 0.5
