<job>
basename = os_ah
<mesh>
nghost = 4
nx1 = 64
nx2 = 64
nx3 = 64
x1min = -64
x1max = 64
x2min = -64
x2max = 64
x3min = -64
x3max = 64
ix1_bc = outflow
ox1_bc = outflow
ix2_bc = outflow
ox2_bc = outflow
ix3_bc = outflow
ox3_bc = outflow
<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16
<mesh_refinement>
refinement = static
max_nmb_per_rank = 400
<time>
evolution = dynamic
integrator = rk4
cfl_number = 0.4
nlim = -1
tlim = 40
ndiag = 100
stop_file = REQUEST_STOP
stop_check_every = 16
<z4c>
lapse_harmonic = 0
lapse_oplog = 2
shift_eta = 2
diss = 0.1
chi_div_floor = 0.00001
damp_kappa1 = 0.02
damp_kappa2 = 0
<refined_region1>
level = 1
x1min = -32
x1max = 32
x2min = -32
x2max = 32
x3min = -32
x3max = 32
<refined_region2>
level = 2
x1min = -16
x1max = 16
x2min = -16
x2max = 16
x3min = -16
x3max = 16
<refined_region3>
level = 3
x1min = -8
x1max = 8
x2min = -8
x2max = 8
x3min = -8
x3max = 8
<refined_region4>
level = 4
x1min = -4
x1max = 4
