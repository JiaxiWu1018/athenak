<comment>
note = Fixed N and mesh; live Z4c; radial measure and sampler explicit below.

problem = ST session 8 production

<job>

basename = yc0500

<mesh>
nghost = 4
ix1_bc = outflow
ox1_bc = outflow
ix2_bc = outflow
ox2_bc = outflow
ix3_bc = outflow
ox3_bc = outflow

nx1 = 128
nx2 = 128
nx3 = 128
x1min = -512
x2min = -512
x3min = -512
x1max = 512
x2max = 512
x3max = 512

<meshblock>

nx1 = 32
nx2 = 32
nx3 = 32

<mesh_refinement>

refinement = adaptive
num_levels = 8
max_nmb_per_rank = 128
ncycle_check = 16
refinement_interval = 16
log_amr_events = true
capacity_stop_fraction = 0.9

<time>
evaluate_initial_constraints = true
evolution = dynamic
integrator = rk4
cfl_number = 0.4

tlim = 300
nlim = 100000000
ndiag = 16
stop_file = REQUEST_STOP
stop_check_every = 1

<z4c>
use_z4c = true
lapse_harmonic = 0.0
lapse_oplog = 2.0
shift_driver = legacy
shift_Gamma = 1.0
shift_H = 0.0
shift_alpha2Gamma = 0.0
shift_eta = 2.0
diss = 0.1
chi_div_floor = 0.00001
damp_kappa1 = 0.02
damp_kappa2 = 0.0

<particles>
particle_type = dust
pusher = gr_boris
init = pgen
feedback = true
mass = 1.0
debug = 1
excise_radius = 0.0
cross_level_deposit = conservative

excise_lapse = 0.1
excise_ah = false
destroy_log = true

<fastflow>

num_horizons = 1
npunct = 0
ntheta = 10
lmax = 6
use_puncture_0 = -1
initial_radius_0 = 0.5
center_x_0 = 0
center_y_0 = 0
center_z_0 = 0
expand_guess = 1
flow_iterations_0 = 200
flow_alpha_beta_const_0 = 1
mass_tol_0 = 0.01
start_time_0 = 0
stop_time_0 = 1e+30
verbose = false
production_quality_0 = true
search_dt_0 = 0.5
quality_hrel_0 = 0.05
quality_cells_0 = 4

<problem>
cluster_mass = 1.0
cluster_seed = 1
cluster_profile_dx = 0.0001
cluster_lambda_tan = 0.0
cluster_eps_out = 0.0
cluster_radial_mode_u = 0.0
cluster_scpd_eps = 0.0
cluster_scpd_target_yc = 0.0
cluster_solve_momentum_constraint = false
cluster_solve_hamiltonian_constraint = false
cluster_t0_dump = initial_particles.bin

user_hist = true

cluster_n = 2000000
cluster_yc = 0.5
cluster_sample_file = /work1/eliasmost/jiaxiwu/st_reconstruction_s08_production_20261021/samples/yc0500.bin
cluster_sampling = stratified
cluster_radial_measure = proper
cluster_velocity_sampling = stratified
production_diagnostics = true
production_history_dt = 0.25
production_cohort_dt = 0.5
production_cohort_stride = 100

<output1>
file_type = hst
data_format = %23.15e

dt = 0.25

<output2>
file_type = pvtk
variable = prtcl_all

dt = 1

<output3>
file_type = bin
variable = z4c
slice_x3 = 0.0
id = z4c2d

dt = 1

<output4>
file_type = bin
variable = tmunu
slice_x3 = 0.0
id = tme2d

dt = 1

<output5>
file_type = bin
variable = con
slice_x3 = 0.0
id = con2d

dt = 1

<output6>
file_type = bin
variable = tmunu
id = tme3d

dt = 1e+30

<output7>
file_type = bin
variable = con
id = con3d

dt = 1e+30

<output8>
file_type = rst

dt = 50

<refined_region1>
level = 1
x1min = -256.0
x2min = -256.0
x3min = -256.0
x1max = 256.0
x2max = 256.0
x3max = 256.0


<refined_region2>
level = 2
x1min = -128.0
x2min = -128.0
x3min = -128.0
x1max = 128.0
x2max = 128.0
x3max = 128.0


<refined_region3>
level = 3
x1min = -64.0
x2min = -64.0
x3min = -64.0
x1max = 64.0
x2max = 64.0
x3max = 64.0


<refined_region4>
level = 4
x1min = -32.0
x2min = -32.0
x3min = -32.0
x1max = 32.0
x2max = 32.0
x3max = 32.0


<refined_region5>
level = 5
x1min = -16.0
x2min = -16.0
x3min = -16.0
x1max = 16.0
x2max = 16.0
x3max = 16.0


<z4c_amr>
method = loehner
loehner_variable = alp_psi7
loehner_threshold = 0.2
radius_0_rad = 256.0
radius_0_reflevel = 1
radius_1_rad = 128.0
radius_1_reflevel = 2
radius_2_rad = 64.0
radius_2_reflevel = 3
radius_3_rad = 32.0
radius_3_reflevel = 4
radius_4_rad = 16.0
radius_4_reflevel = 5


<amr_criterion1>
method = user

